# Copy this file to backend/.env (and fill in real values) before running the API or the batch evaluator.

# --- Server ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# --- Database (MongoDB Atlas free M0 cluster, or a local mongod) ---
# Required to run the API server (`npm run dev:api` / `npm start`).
# NOT required to run `npm run evaluate` - the batch CLI never touches Mongo.
MONGODB_URI=mongodb://localhost:27017/prepkit

# --- Sessions ---
# Any random string; used to hash/sign session tokens. Change this in production.
SESSION_SECRET=change-me-to-a-long-random-string

# --- LLM provider ---
# Currently supported: "gemini" (Google AI Studio has a genuine free tier: https://aistudio.google.com/app/apikey)
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-flash-lite-latest
LLM_MAX_RETRIES=3

# --- Search provider (optional) ---
# Brave Search API free tier (https://brave.com/search/api/) - used to look for public
# discussion of a company's interview process. If left blank, the pipeline honestly
# reports "no public discussion found" instead of failing.
SEARCH_API_KEY=

# --- Research/crawler tuning ---
MAX_CRAWL_PAGES=6
CRAWL_TIMEOUT_MS=8000
MAX_RESPONSE_SIZE=5000000

# --- Generation tuning ---
COVERAGE_MAX_PASSES=3

# --- Batch grading against a local fixture server (e.g. http://localhost:8099/acme/) ---
# Not needed in normal development (NODE_ENV=development already allows loopback hosts).
# Set to "true" only if you need to allow loopback/private hosts while NODE_ENV=production.
EVAL_ALLOW_LOCALHOST=false

# --- Frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=http://localhost:4000
